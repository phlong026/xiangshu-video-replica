# 短视频复刻工作台 — 服务端必需环境变量示例
# 复制为 .env 并按需填写;真实密钥只放服务端密钥存储,不要提交到仓库。

# 服务端数据目录(必填)
# 指向本机磁盘上的 SQLite 数据库文件(不得放在网络/云存储目录)
VIDEO_REPLICA_DB_PATH=/path/to/video-replica/data/app.db

# 设置加密密钥(必填,仅用于 Fernet 对称加密;生成: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
VIDEO_REPLICA_SETTINGS_KEY=replace-with-a-fernet-key

# 本地存储根目录(使用 active_storage_provider=local 时必填)
VIDEO_REPLICA_STORAGE_ROOT=/path/to/video-replica/storage

# 本地后端自动拉起命令(可选;桌面端启动时用它拉起 FastAPI+Worker)
# 默认回退到随包 start-backend.sh / start-backend.bat
# VIDEO_REPLICA_BOOT_COMMAND=sh /path/to/start-backend.sh

# 桌面端 dev 身份(仅开发模式;生产用真实登录/签名会话)
# VITE_DEV_USER_ID=admin_1

# 前端视频生成 Provider 路由(可选;Vite 构建期变量,写入 client/.env.local)
# 默认 metaso=真实 MiniMax H3(产生付费调用);fake_h3=本地模拟(不触达 Provider)。
# 开发联调不想产生付费调用时才设置 fake_h3。
# VITE_GENERATION_PROVIDER=fake_h3
