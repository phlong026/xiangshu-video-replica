# Customer V3 same-origin ingress. Replace the example host/certificate paths
# before enabling this file. Uvicorn proxy parsing must remain disabled: the
# application verifies this Nginx peer and parses the single rewritten client IP.

upstream video_replica_customer_api {
    least_conn;
    server 127.0.0.1:8001 max_fails=3 fail_timeout=10s;
    server 127.0.0.1:8002 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl http2;
    server_name video.example.com;

    ssl_certificate /etc/letsencrypt/live/video.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/video.example.com/privkey.pem;

    root /opt/video-replica/app/client/dist;
    index index.html;
    client_max_body_size 2g;

    location = /live {
        proxy_pass http://video_replica_customer_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
    }

    location = /ready {
        proxy_pass http://video_replica_customer_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
    }

    location ^~ /api/ {
        proxy_pass http://video_replica_customer_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
    }

    # Both the customer workspace and /admin are browser routes in the same
    # compiled SPA, so auth cookies never cross an origin boundary.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Nginx does not retry POST/PATCH/PUT requests unless `non_idempotent` is
# explicitly added above. Do not add it: paid-provider submissions rely on
# application idempotency and must never be replayed by the proxy.
