# 客户版生产环境变量样例（占位符 only，真实密钥永不入库/入仓）
# 复制为部署环境的 env 文件并替换全部占位符；配合 VIDEO_REPLICA_CUSTOMER_PRODUCTION=true
# 使用时，以下违规配置会导致启动 fail-closed（T09 / DB-08）：
#   - VIDEO_REPLICA_DB_PATH / sqlite:// 数据库（客户生产仅允许 PostgreSQL）
#   - CONTROL_PROXY_TOKEN_DIGEST / CONTROL_ADMIN_USER_ID（单管理员映射）
#   - VIDEO_REPLICA_AUTH_MODE=desktop|development、VIDEO_REPLICA_ALLOW_DEV_IDENTITY_HEADER=1、
#     VIDEO_REPLICA_DESKTOP_USER_ID（开发身份）
#   - VIDEO_REPLICA_STORAGE_ROOT（本地持久资产；客户生产使用私有 COS）
#   - 缺少公开 HTTPS origin / 可信代理 CIDR 边界
#   - 缺少或无效的 code/device/session HMAC、幂等/导出 AEAD、settings/admin 密钥

# 客户生产边界（设为 true 后上述违规项将直接拒绝启动）
VIDEO_REPLICA_CUSTOMER_PRODUCTION=true

# 对外唯一 HTTPS origin（固定标准 443 端口，无路径、query、fragment；Host/CORS 精确匹配）
VIDEO_REPLICA_PUBLIC_ORIGIN=https://video.example.com
# 资源签名链接与 ZPay 回调也只能使用同一 origin；客户生产必须与上一项逐字相同。
PUBLIC_BASE_URL=https://video.example.com
# 只有这些原始网络对端可声明转发头；使用 canonical CIDR，禁止 0.0.0.0/0 与 ::/0。
# Nginx 与 API 同机时通常只需回环；独立 LB 时填其最小专用网段。
VIDEO_REPLICA_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# PostgreSQL DSN（必填；客户生产唯一数据真源）。启动门拒绝 disable/allow/prefer
# 或缺失 sslmode；生产模板固定 verify-full，并校验私网 HA 端点主机名与 CA。
# 将 CA 证书以只读文件部署到下列路径，禁止把证书内容或真实 DSN 提交到仓库。
VIDEO_REPLICA_DATABASE_URL=postgresql://USER:PASSWORD@PGHOST:5432/DBNAME?sslmode=verify-full&sslrootcert=%2Fetc%2Fvideo-replica%2Fpostgresql-ca.pem

# Provider/COS/ZPay 配置的 Fernet 加密根密钥（客户多实例必须由共享密钥存储注入；
# 不得依赖单机 DPAPI/Keychain）。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VIDEO_REPLICA_SETTINGS_KEY=replace-with-fernet-key

# 管理端 per-operator 会话签名密钥（T09）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 版本化：换钥时配置 _V2 并将旧版本保留至全部凭证过期
VIDEO_REPLICA_ADMIN_SESSION_HMAC_KEY=replace-with-at-least-32-byte-random-key
# VIDEO_REPLICA_ADMIN_SESSION_HMAC_KEY_V2=rotate-here
# 管理会话 TTL（秒，60–86400，默认 28800）
# VIDEO_REPLICA_ADMIN_SESSION_TTL_SECONDS=28800
# 激活码批次铸造 kill-switch（M2 评审 H2 / PRICE-01）：客户销售价与内部
# 基础价的关系决议冻结前，批次创建默认拒绝（403 BATCH_CREATION_DISABLED）；
# 需要铸造时显式设为 true，决议冻结后随 PRICE-01 一并移除
# VIDEO_REPLICA_ALLOW_ACTIVATION_BATCH_CREATION=true

# 激活码摘要 HMAC 密钥（T11；原始字符串，≥32 字节）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 版本化：换钥时配置 _V2 并保留旧版本，直至旧摘要码全部失效
VIDEO_REPLICA_ACTIVATION_CODE_HMAC_KEY=replace-with-at-least-32-byte-random-key
# VIDEO_REPLICA_ACTIVATION_CODE_HMAC_KEY_V2=rotate-here
# 激活码导出信封 AES-256-GCM 密钥（T11；urlsafe-base64，解码后恰 32 字节——AES-GCM 仅接受 16/24/32 字节，本路径为 AES-256）
# 生成：python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 版本化：换钥时配置 _V2 并保留旧版本，直至旧导出包全部过期
VIDEO_REPLICA_ACTIVATION_EXPORT_AEAD_KEY=replace-with-urlsafe-base64-32-byte-key
# VIDEO_REPLICA_ACTIVATION_EXPORT_AEAD_KEY_V2=rotate-here

# 设备指纹/凭据 HMAC 密钥（T13；原始字符串，≥32 字节）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 版本化：换钥时配置 _V2 并保留旧版本，直至旧版本绑定的设备全部解绑/撤销
VIDEO_REPLICA_DEVICE_FINGERPRINT_HMAC_KEY=replace-with-at-least-32-byte-random-key
# VIDEO_REPLICA_DEVICE_FINGERPRINT_HMAC_KEY_V2=rotate-here

# 客户幂等恢复信封 AES-256-GCM 密钥（T14/ACT-07；urlsafe-base64，解码后恰 32 字节）
# 生成：python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 版本化：换钥时配置 _V2 并保留旧版本，直至全部旧信封的恢复窗口过期
VIDEO_REPLICA_CUSTOMER_IDEMPOTENCY_AEAD_KEY=replace-with-urlsafe-base64-32-byte-key
# VIDEO_REPLICA_CUSTOMER_IDEMPOTENCY_AEAD_KEY_V2=rotate-here
# 幂等恢复窗口（秒，>0，默认 86400）：到期后同 key 重试返回 409，
# 过期密文由 video-replica-maintenance.timer 每日清理
# VIDEO_REPLICA_CUSTOMER_IDEMPOTENCY_RECOVERY_SECONDS=86400

# 共享限流与防枚举（T15/ACT-08；计数器存 PG，多 API 实例共预算）
# 激活接口每 IP 窗口内次数（>0，默认 10）
# VIDEO_REPLICA_RATE_LIMIT_ACTIVATE_IP=10
# 激活接口每码（HMAC 摘要）窗口内次数（>0，默认 5）
# VIDEO_REPLICA_RATE_LIMIT_ACTIVATE_CODE=5
# 限流固定窗口秒数（>0，默认 300）
# VIDEO_REPLICA_RATE_LIMIT_WINDOW_SECONDS=300
# 失败事件告警阈值（窗口内同维度失败数，>0，默认 20；达到后记录 ERROR 级告警日志）
# VIDEO_REPLICA_RATE_LIMIT_FAILURE_ALERT_THRESHOLD=20
# 部署拓扑注意：限流按“客户端 IP”维度计数。多实例必须在负载均衡后共享同一 PG。
# Uvicorn 必须使用 --no-proxy-headers，保留 request.client 为原始代理对端；应用会在
# request.client 已被改写成 X-Forwarded-For 时返回 503 并拒绝信任该请求。应用仅在
# 对端命中 VIDEO_REPLICA_TRUSTED_PROXY_CIDRS 后才接受转发头。最后一跳 Nginx 必须覆盖
# （而不是追加）X-Forwarded-For 为单一已解析客户端 IP，并固定 Host 与
# X-Forwarded-Proto=https；逗号链、缺失/非法 IP、错误 Host/协议均由应用拒绝。
# 企业 NAT 出口（多设备共享公网 IP）下默认 IP 预算 10 偏紧，属部署调参项。
# T35 已关闭原 loopback/真实 IP 互斥的代码缺口；T36 仍须用 customer Nginx + 双 API
# 实测“不同客户端 IP 经反代进入不同 PG 限流桶”，单元测试不能替代 staging 证据。

# COS、ZPay 与付费 Provider 业务配置不通过环境变量注入。它们在客户生产启动
# 前由 T07 受控导入或隔离的管理设置控制面使用 VIDEO_REPLICA_SETTINGS_KEY
# 加密后写入 PostgreSQL provider_settings；legacy/dev 身份不得留在本文件。
# 客户生产启动门要求 active_storage_provider=cos 且 COS 四项必填配置完整；
# 缺失时 API/Worker 启动失败，/ready 返回 503，绝不回退本地盘。
# 真实 COS/ZPay/Provider 凭据只在 T40 获得明确授权后配置和调用。
