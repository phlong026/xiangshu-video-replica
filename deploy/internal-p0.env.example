# Copy to /etc/video-replica/internal-p0.env and chmod 600.
# Never commit the real values. The raw control proxy token belongs only in nginx.

VIDEO_REPLICA_DB_PATH=/var/lib/video-replica/app.db
VIDEO_REPLICA_STORAGE_ROOT=/var/lib/video-replica/storage
VIDEO_REPLICA_AUTH_MODE=internal
VIDEO_REPLICA_ALLOW_DEV_IDENTITY_HEADER=0
VIDEO_REPLICA_DESKTOP_USER_ID=

# Linux services use the explicitly provisioned Fernet key and do not use a desktop key store.
VIDEO_REPLICA_SETTINGS_KEY=REPLACE_WITH_FERNET_KEY
VIDEO_REPLICA_DISABLE_LOCAL_KEYSTORE=1

# Only the digest is visible to FastAPI. Generate it from the raw nginx token.
CONTROL_PROXY_TOKEN_DIGEST=REPLACE_WITH_SHA256_DIGEST
CONTROL_ADMIN_USER_ID=REPLACE_WITH_ADMIN_USER_ID

# ZPay derives notify_url and return_url from this HTTPS origin.
PUBLIC_BASE_URL=https://internal.example.com
ZPAY_GATEWAY_URL=https://zpayz.cn/submit.php
